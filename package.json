{
  "name": "angular-lab",
  "version": "0.0.0",
  "type": "module",
  "description": "Interactive learning platform for modern Angular — guided missions with real in-browser code execution.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/angular-lab.git"
  },
  "homepage": "https://angular-lab.pages.dev",
  "bugs": {
    "url": "https://github.com/Andersseen/angular-lab/issues"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20.19.1"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "pnpm run dev",
    "dev:pages": "pnpm build:prod && pnpm exec wrangler pages dev dist/analog/public --port 8788",
    "build": "vite build",
    "build:prod": "node scripts/generate-seo-assets.mjs && vite build --mode production",
    "generate:seo": "node scripts/generate-seo-assets.mjs",
    "watch": "vite build --watch",
    "db:migrate": "pnpm exec wrangler d1 migrations apply angular-lab-db --local",
    "test:unit": "vitest run",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "install:vertex": "mkdir -p public/vertex-editor && curl -fsSL -o public/vertex-editor/web-editor.min.js https://github.com/Andersseen/vertex/releases/download/web-editor-latest/web-editor.min.js && curl -fsSL -o public/vertex-editor/web-editor-lite.min.js https://github.com/Andersseen/vertex/releases/download/web-editor-latest/web-editor-lite.min.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "npx serve dist/analog/public",
    "deploy": "pnpm build:prod && pnpm exec wrangler pages deploy dist/analog/public --project-name=angular-lab"
  },
  "private": true,
  "dependencies": {
    "@analogjs/router": "^2.7.1",
    "@angular/animations": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-server": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@tailwindcss/vite": "^4.1.4",
    "@voltui/components": "^0.5.0",
    "angular-movement": "^0.5.0",
    "h3": "^1.13.0",
    "lumen-icons": "^0.2.0",
    "postcss": "^8.5.3",
    "quartz-headless": "^0.0.3",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.7.1",
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@analogjs/vitest-angular": "^2.7.1",
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@cloudflare/workers-types": "^5.20260703.1",
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/angular": "^17.2.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^9.24.0",
    "globals": "^17.7.0",
    "jsdom": "^22.0.0",
    "playwright": "^1.52.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.107.0",
    "zone.js": "^0.15.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest",
    "@angular/common": "$@angular/common",
    "@angular/core": "$@angular/core"
  }
}
